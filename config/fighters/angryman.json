{
  "$schema": "./fighter.schema.json",
  "id": "angryman",
  "name": "Angry Man",
  "color": "#d94a38",
  "combat": {
    "faceTarget": { "mode": "always" },
    "abilities": [{
      "id": "charge",
      "trigger": { "type": "nearest-enemy" },
      "timing": { "cooldownMs": 3000, "windupFrames": 105, "activeFrames": 22, "recoveryFrames": 18 },
      "actions": [
        { "type": "dash", "speedMultiplier": 5, "accelerationForce": 0.018, "endOn": ["fighter-collision", "wall-collision"] },
        { "type": "damage", "amount": 140 },
        { "type": "knockback", "forceMagnitude": 0.45 }
      ]
    }]
  },
  "presentation": {
    "image": "assets/fighters/angryman/sprites/angryman.png",
    "imageScale": 3,
    "imageOffset": { "x": 1, "y": 6 },
    "poses": {
      "idle": {
        "image": "assets/fighters/angryman/sprites/angryman.png",
        "imageCrop": { "x": 0, "y": 0, "width": 1086, "height": 1128 },
        "imageScale": 2.6,
        "imageOffset": { "x": -1, "y": -3 }
      },
      "attackWindup": {
        "image": "assets/fighters/angryman/sprites/angryman-windup.png",
        "imageCrop": { "x": 0, "y": 0, "width": 1086, "height": 1060 },
        "imageScale": 3,
        "imageOffset": { "x": -1, "y": 3 }
      },
      "attackActive": {
        "image": "assets/fighters/angryman/sprites/angryman-dash.png",
        "imageCrop": { "x": 0, "y": 0, "width": 1086, "height": 1066 },
        "imageScale": 3,
        "imageOffset": { "x": 23, "y": -1 }
      }
    },
    "imageCrop": { "x": 0, "y": 0, "width": 1086, "height": 1023 },
    "defaultFacing": "left"
  }
}
