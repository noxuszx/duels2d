          "x": 242,
          "y": 124,
          "width": 744,
          "height": 901
        }
      },
      "attackActive": {
        "image": "assets/fighters/depressedman/sprites/depressedman.out.png",
        "imageCrop": {
          "x": 242,
          "y": 124,
          "width": 744,
          "height": 901
        }
      }
    }
  },
  "components": {
