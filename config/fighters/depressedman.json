{
  "$schema": "./fighter.schema.json",
  "id": "depressedman",
  "name": "Sad Man",
  "color": "#5f7ea8",
  "combat": {
    "faceTarget": {
      "mode": "always"
    }
  },
  "presentation": {
    "image": "assets/fighters/depressedman/sprites/depressedman.out.png",
    "imageScale": 2.8,
