{
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "fighter.schema.json",
      "title": "Duels2D Fighter",
      "type": "object",
      "required": ["id", "name", "color"],
      "properties": {
            "$schema": { "type": "string" },
            "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "name": { "type": "string", "minLength": 1 },
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "combat": { "$ref": "#/$defs/combat" },
            "body": { "$ref": "#/$defs/body" },
            "presentation": { "$ref": "#/$defs/presentation" },
            "lines": { "$ref": "#/$defs/lines" }
      },
      "additionalProperties": false,
      "$defs": {
            "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
            "nonNegativeNumber": { "type": "number", "minimum": 0 },
            "vector": {
                  "type": "object",
                  "required": ["x", "y"],
                  "properties": {
                        "x": { "type": "number" },
                        "y": { "type": "number" }
                  },
                  "additionalProperties": false
            },
            "crop": {
                  "type": "object",
                  "required": ["x", "y", "width", "height"],
                  "properties": {
                        "x": { "type": "number", "minimum": 0 },
                        "y": { "type": "number", "minimum": 0 },
                        "width": { "$ref": "#/$defs/positiveNumber" },
                        "height": { "$ref": "#/$defs/positiveNumber" }
                  },
                  "additionalProperties": false
            },
            "faceTarget": {
                  "type": "object",
                  "required": ["mode"],
                  "properties": {
                        "mode": { "enum": ["never", "always", "range"] }
                  },
                  "additionalProperties": false
            },
            "abilityTiming": {
                  "type": "object",
                  "required": [
                        "cooldownMs",
                        "windupFrames",
                        "activeFrames",
                        "recoveryFrames"
                  ],
                  "properties": {
                        "cooldownMs": { "$ref": "#/$defs/positiveNumber" },
                        "windupFrames": { "type": "integer", "minimum": 0 },
                        "activeFrames": { "type": "integer", "minimum": 0 },
                        "recoveryFrames": { "type": "integer", "minimum": 0 }
                  },
                  "additionalProperties": false
            },
            "knockback": {
                  "oneOf": [
                        { "type": "boolean" },
                        { "$ref": "#/$defs/knockbackConfig" }
                  ]
            },
            "knockbackConfig": {
                  "type": "object",
                  "required": ["forceMagnitude"],
                  "properties": {
                        "forceMagnitude": {
                              "$ref": "#/$defs/positiveNumber"
                        }
                  },
                  "additionalProperties": false
            },
            "projectile": {
                  "type": "object",
                  "required": [
                        "radius",
                        "speed",
                        "damage",
                        "lifetimeMs",
                        "image"
                  ],
                  "properties": {
                        "radius": { "$ref": "#/$defs/positiveNumber" },
                        "speed": { "$ref": "#/$defs/positiveNumber" },
                        "damage": { "$ref": "#/$defs/nonNegativeNumber" },
                        "knockback": { "$ref": "#/$defs/knockback" },
                        "lifetimeMs": { "$ref": "#/$defs/positiveNumber" },
                        "rotationSpeed": { "type": "number" },
                        "imageScales": {
                              "type": "object",
                              "additionalProperties": {
                                    "$ref": "#/$defs/positiveNumber"
                              }
                        },
                        "image": {
                              "oneOf": [
                                    { "type": "string", "minLength": 1 },
                                    {
                                          "type": "array",
                                          "items": { "type": "string", "minLength": 1 },
                                          "minItems": 1
                                    }
                              ]
                        }
                  },
                  "additionalProperties": false
            },
            "abilityTrigger": {
                  "oneOf": [
                        {
                              "type": "object",
                              "required": ["type"],
                              "properties": {
                                    "type": { "const": "nearest-enemy" }
                              },
                              "additionalProperties": false
                        },
                        {
                              "type": "object",
                              "required": ["type", "rangePadding"],
                              "properties": {
                                    "type": { "const": "enemy-in-range" },
                                    "rangePadding": {
                                          "$ref": "#/$defs/nonNegativeNumber"
                                    }
                              },
                              "additionalProperties": false
                        }
                  ]
            },
            "abilityAction": {
                  "oneOf": [
                        {
                              "type": "object",
                              "required": ["type", "amount"],
                              "properties": {
                                    "type": { "const": "damage" },
                                    "amount": { "$ref": "#/$defs/nonNegativeNumber" }
                              },
                              "additionalProperties": false
                        },
                        {
                              "type": "object",
                              "required": ["type", "forceMagnitude"],
                              "properties": {
                                    "type": { "const": "knockback" },
                                    "forceMagnitude": { "$ref": "#/$defs/positiveNumber" }
                              },
                              "additionalProperties": false
                        },
                        {
                              "type": "object",
                              "required": ["type", "speedMultiplier", "accelerationForce", "endOn"],
                              "properties": {
                                    "type": { "const": "dash" },
                                    "speedMultiplier": { "$ref": "#/$defs/positiveNumber" },
                                    "accelerationForce": { "$ref": "#/$defs/positiveNumber" },
                                    "endOn": {
                                          "type": "array",
                                          "items": { "enum": ["fighter-collision", "wall-collision"] },
                                          "uniqueItems": true
                                    }
                              },
                              "additionalProperties": false
                        },
                        {
                              "type": "object",
                              "required": ["type", "startDegrees", "endDegrees"],
                              "properties": {
                                    "type": { "const": "swing" },
                                    "startDegrees": { "type": "number" },
                                    "endDegrees": { "type": "number" }
                              },
                              "additionalProperties": false
                        },
                        {
                              "type": "object",
                              "required": ["type", "projectile"],
                              "properties": {
                                    "type": { "const": "spawn-projectile" },
                                    "projectile": { "$ref": "#/$defs/projectile" }
                              },
                              "additionalProperties": false
                        }
                  ]
            },
            "ability": {
                  "type": "object",
                  "required": ["id", "trigger", "timing", "actions"],
                  "properties": {
                        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                        "trigger": { "$ref": "#/$defs/abilityTrigger" },
                        "timing": { "$ref": "#/$defs/abilityTiming" },
                        "actions": {
                              "type": "array",
                              "items": { "$ref": "#/$defs/abilityAction" },
                              "minItems": 1
                        }
                  },
                  "additionalProperties": false
            },
            "combat": {
                  "type": "object",
                  "properties": {
                        "maxHealth": { "$ref": "#/$defs/positiveNumber" },
                        "speed": { "$ref": "#/$defs/positiveNumber" },
                        "baseDamage": { "$ref": "#/$defs/nonNegativeNumber" },
                        "faceTarget": { "$ref": "#/$defs/faceTarget" },
                        "abilities": {
                              "type": "array",
                              "items": { "$ref": "#/$defs/ability" }
                        }
                  },
                  "additionalProperties": false
            },
            "hitbox": {
                  "oneOf": [
                        {
                              "type": "object",
                              "required": ["type", "width", "height"],
                              "properties": {
                                    "type": { "const": "box" },
                                    "width": {
                                          "$ref": "#/$defs/positiveNumber"
                                    },
                                    "height": {
                                          "$ref": "#/$defs/positiveNumber"
                                    }
                              },
                              "additionalProperties": false
                        },
                        {
                              "type": "object",
                              "required": ["type", "radius"],
                              "properties": {
                                    "type": { "const": "circle" },
                                    "radius": {
                                          "$ref": "#/$defs/positiveNumber"
                                    }
                              },
                              "additionalProperties": false
                        }
                  ]
            },
            "body": {
                  "type": "object",
                  "properties": {
                        "radius": { "$ref": "#/$defs/positiveNumber" },
                        "hitbox": { "$ref": "#/$defs/hitbox" },
                        "hitboxOffset": { "$ref": "#/$defs/vector" }
                  },
                  "additionalProperties": false
            },
            "pose": {
                  "oneOf": [
                        { "type": "string", "minLength": 1 },
                        {
                              "type": "object",
                              "required": ["image"],
                              "properties": {
                                    "image": {
                                          "type": "string",
                                          "minLength": 1
                                    },
                                    "imageCrop": {
                                          "oneOf": [
                                                { "type": "null" },
                                                { "$ref": "#/$defs/crop" }
                                          ]
                                    },
                                    "imageScale": {
                                          "$ref": "#/$defs/positiveNumber"
                                    },
                                    "imageOffset": { "$ref": "#/$defs/vector" }
                              },
                              "additionalProperties": false
                        }
                  ]
            },
            "presentation": {
                  "type": "object",
                  "properties": {
                        "image": { "type": ["string", "null"] },
                        "imageScale": { "$ref": "#/$defs/positiveNumber" },
                        "imageOffset": { "$ref": "#/$defs/vector" },
                        "imageCrop": {
                              "oneOf": [
                                    { "type": "null" },
                                    { "$ref": "#/$defs/crop" }
                              ]
                        },
                        "healthBarOffset": { "$ref": "#/$defs/vector" },
                        "weaponScale": { "$ref": "#/$defs/positiveNumber" },
                        "weaponOffset": { "$ref": "#/$defs/vector" },
                        "weaponPivot": { "$ref": "#/$defs/vector" },
                        "weaponIdle": { "type": ["string", "null"] },
                        "weaponAttack": { "type": ["string", "null"] },
                        "defaultFacing": { "enum": ["left", "right"] },
                        "poses": {
                              "oneOf": [
                                    { "type": "null" },
                                    {
                                          "type": "object",
                                          "additionalProperties": {
                                                "$ref": "#/$defs/pose"
                                          }
                                    }
                              ]
                        }
                  },
                  "additionalProperties": false
            },
            "lines": {
                  "type": "object",
                  "properties": {
                        "ambientIntervalMs": {
                              "$ref": "#/$defs/positiveNumber"
                        },
                        "ambientChance": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                        }
                  },
                  "additionalProperties": {
                        "type": "array",
                        "items": { "type": "string", "minLength": 1 }
                  }
            }
      }
}
