{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fighter.schema.json",
  "title": "Duels2D Fighter",
  "type": "object",
  "required": [
    "id",
    "name",
    "color"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "selectable": {
      "type": "boolean"
    },
    "combat": {
      "$ref": "#/$defs/combat"
    },
    "body": {
      "$ref": "#/$defs/body"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "lines": {
      "$ref": "#/$defs/lines"
    },
    "components": {
      "$ref": "#/$defs/components"
    },
    "moves": {
      "$ref": "#/$defs/moves"
    },
    "forms": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/form"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "vector": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "$ref": "#/$defs/positiveNumber"
        },
        "height": {
          "$ref": "#/$defs/positiveNumber"
        }
      },
      "additionalProperties": false
    },
    "faceTarget": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "never",
            "always",
            "range"
          ]
        }
      },
      "additionalProperties": false
    },
    "saucerSettings": {
      "type": "object",
      "required": [
        "image",
        "width",
        "height",
        "altitude",
        "speed",
        "beamWidth",
        "beamDamage",
        "beamDamageIntervalMs",
        "beamDurationMs",
        "beamIntervalMs",
        "beamColor",
        "summonConfigId",
        "firstSpawnDelayMs",
        "spawnIntervalMs",
        "maxSpawns"
      ],
      "properties": {
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "imageCrop": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/crop"
            }
          ]
        },
        "width": {
          "$ref": "#/$defs/positiveNumber"
        },
        "height": {
          "$ref": "#/$defs/positiveNumber"
        },
        "altitude": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "speed": {
          "$ref": "#/$defs/positiveNumber"
        },
        "beamWidth": {
          "$ref": "#/$defs/positiveNumber"
        },
        "beamDamage": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "beamDamageIntervalMs": {
          "$ref": "#/$defs/positiveNumber"
        },
        "beamDurationMs": {
          "$ref": "#/$defs/positiveNumber"
        },
        "beamIntervalMs": {
          "$ref": "#/$defs/positiveNumber"
        },
        "beamColor": {
          "type": "string",
          "minLength": 1
        },
        "summonConfigId": {
          "type": "string",
          "minLength": 1
        },
        "firstSpawnDelayMs": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "spawnIntervalMs": {
          "$ref": "#/$defs/positiveNumber"
        },
        "maxSpawns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "combat": {
      "type": "object",
      "properties": {
        "maxHealth": {
          "$ref": "#/$defs/positiveNumber"
        },
        "speed": {
          "$ref": "#/$defs/positiveNumber"
        },
        "baseDamage": {
          "$ref": "#/$defs/nonNegativeNumber"
        },
        "impactDamageMultiplier": {
          "$ref": "#/$defs/nonNegativeNumber",
          "description": "Wall and entity impact damage scaling: 0 is immune, 1 is normal. Does not affect attack damage or collision response."
        },
        "faceTarget": {
          "$ref": "#/$defs/faceTarget"
        }
      },
      "additionalProperties": false
    },
    "hitbox": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "width",
            "height"
          ],
          "properties": {
            "type": {
              "const": "box"
            },
            "width": {
              "$ref": "#/$defs/positiveNumber"
            },
            "height": {
              "$ref": "#/$defs/positiveNumber"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "radius"
          ],
          "properties": {
            "type": {
              "const": "circle"
            },
            "radius": {
              "$ref": "#/$defs/positiveNumber"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "body": {
      "type": "object",
      "properties": {
        "radius": {
          "$ref": "#/$defs/positiveNumber"
        },
        "hitbox": {
          "$ref": "#/$defs/hitbox"
        },
        "hitboxOffset": {
          "$ref": "#/$defs/vector"
        }
      },
      "additionalProperties": false
    },
    "aimSkill": {
      "type": "object",
      "required": [
        "muzzle"
      ],
      "properties": {
        "muzzle": {
          "$ref": "#/$defs/vector"
        },
        "pivot": {
          "$ref": "#/$defs/vector"
        },
        "forwardDegrees": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "pose": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "image"
          ],
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            },
            "imageCrop": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/crop"
                }
              ]
            },
            "imageScale": {
              "$ref": "#/$defs/positiveNumber"
            },
            "imageOffset": {
              "$ref": "#/$defs/vector"
            },
            "aim": {
              "$ref": "#/$defs/aimSkill"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "imageScale": {
          "$ref": "#/$defs/positiveNumber"
        },
        "imageOffset": {
          "$ref": "#/$defs/vector"
        },
        "imageCrop": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/crop"
            }
          ]
        },
        "healthBarOffset": {
          "$ref": "#/$defs/vector"
        },
        "weaponScale": {
          "$ref": "#/$defs/positiveNumber"
        },
        "weaponOffset": {
          "$ref": "#/$defs/vector"
        },
        "weaponPivot": {
          "$ref": "#/$defs/vector"
        },
        "weaponIdle": {
          "type": [
            "string",
            "null"
          ]
        },
        "weaponAttack": {
          "type": [
            "string",
            "null"
          ]
        },
        "defaultFacing": {
          "enum": [
            "left",
            "right"
          ]
        },
        "poses": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/pose"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "lines": {
      "type": "object",
      "properties": {
        "ambientIntervalMs": {
          "$ref": "#/$defs/positiveNumber"
        },
        "ambientChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "wallCrawl": {
          "type": "object",
          "properties": {
            "durationMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "speedMultiplier": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "poses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "poseIntervalMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sound": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "durationMs",
            "speedMultiplier",
            "poses",
            "poseIntervalMs"
          ],
          "additionalProperties": false
        },
        "dash": {
          "type": "object",
          "properties": {
            "speedMultiplier": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "accelerationForce": {
              "type": "number",
              "minimum": 0
            },
            "endOn": {
              "type": "array",
              "items": {
                "enum": [
                  "fighter-collision",
                  "wall-collision"
                ]
              },
              "minItems": 0
            },
            "maxDurationMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "pose": {
              "type": "string",
              "minLength": 1
            },
            "sound": {
              "type": "string",
              "minLength": 1
            },
            "hitSound": {
              "type": "string",
              "minLength": 1
            },
            "hit": {
              "type": "object",
              "properties": {
                "damage": {
                  "type": "number",
                  "minimum": 0
                },
                "knockback": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "speedMultiplier",
            "accelerationForce",
            "endOn",
            "maxDurationMs",
            "hit"
          ],
          "additionalProperties": false
        },
        "melee": {
          "type": "object",
          "properties": {
            "damage": {
              "type": "number",
              "minimum": 0
            },
            "knockback": {
              "type": "number",
              "minimum": 0
            },
            "hitbox": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "offset": {
                  "$ref": "#/$defs/vector"
                }
              },
              "required": [
                "width",
                "height",
                "offset"
              ],
              "additionalProperties": false
            },
            "swing": {
              "type": "object",
              "properties": {
                "startDegrees": {
                  "type": "number"
                },
                "endDegrees": {
                  "type": "number"
                }
              },
              "required": [
                "startDegrees",
                "endDegrees"
              ],
              "additionalProperties": false
            },
            "pose": {
              "type": "string",
              "minLength": 1
            },
            "sound": {
              "type": "string",
              "minLength": 1
            },
            "hitSound": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "projectile": {
          "type": "object",
          "properties": {
            "projectile": {
              "type": "object",
              "properties": {
                "radius": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "speed": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "damage": {
                  "type": "number",
                  "minimum": 0
                },
                "flight": {
                  "type": "object",
                  "properties": {
                    "collision": {
                      "type": "object",
                      "properties": {
                        "response": {
                          "enum": [
                            "physical",
                            "sensor"
                          ]
                        },
                        "enemyContact": {
                          "enum": [
                            "consume",
                            "pierce"
                          ]
                        },
                        "ownerContact": {
                          "enum": [
                            "ignore",
                            "catch"
                          ]
                        },
                        "walls": {
                          "enum": [
                            "ignore",
                            "bounce"
                          ]
                        }
                      },
                      "required": [
                        "response",
                        "enemyContact",
                        "ownerContact",
                        "walls"
                      ],
                      "additionalProperties": false
                    },
                    "lifetime": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "duration"
                            },
                            "durationMs": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            }
                          },
                          "required": [
                            "type",
                            "durationMs"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "persistent"
                            }
                          },
                          "required": [
                            "type"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "ownership": {
                      "type": "object",
                      "properties": {
                        "onOwnerDeath": {
                          "enum": [
                            "remove",
                            "persist"
                          ]
                        },
                        "onOwnerRemoval": {
                          "enum": [
                            "remove",
                            "persist"
                          ]
                        },
                        "onMatchEnd": {
                          "enum": [
                            "remove",
                            "persist"
                          ]
                        }
                      },
                      "required": [
                        "onOwnerDeath",
                        "onOwnerRemoval",
                        "onMatchEnd"
                      ],
                      "additionalProperties": false
                    },
                    "knockback": {
                      "type": "object",
                      "properties": {
                        "forceMagnitude": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "forceMagnitude"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "collision",
                    "lifetime",
                    "ownership"
                  ],
                  "additionalProperties": false
                },
                "rotationSpeed": {
                  "type": "number"
                },
                "image": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  ]
                },
                "imageScales": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "required": [
                "radius",
                "speed",
                "damage",
                "flight",
                "image"
              ],
              "additionalProperties": false
            },
            "recoil": {
              "type": "number",
              "minimum": 0
            },
            "sound": {
              "type": "string",
              "minLength": 1
            },
            "hitSound": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "projectile"
          ],
          "additionalProperties": false
        },
        "aim": {
          "$ref": "#/$defs/aimSkill"
        },
        "weaponAim": {
          "$ref": "#/$defs/aimSkill"
        },
        "damageRamp": {
          "type": "object",
          "properties": {
            "amountPerIncrease": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "maxDamage": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "hurtThrowThreshold": {
              "type": "number",
              "minimum": 0
            },
            "ratesPerSecond": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "minItems": 1
            },
            "increasePoseMs": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "amountPerIncrease",
            "maxDamage",
            "ratesPerSecond",
            "increasePoseMs"
          ],
          "additionalProperties": false
        },
        "instantLaser": {
          "type": "object",
          "properties": {
            "damage": {
              "type": "number",
              "minimum": 0
            },
            "intervalMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "range": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "flashMs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "damage",
            "intervalMs",
            "width",
            "range",
            "flashMs",
            "color"
          ],
          "additionalProperties": false
        },
        "saucer": {
          "$ref": "#/$defs/saucerSettings"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "move": {
      "type": "object",
      "properties": {
        "cooldownMs": {
          "type": "number",
          "minimum": 0
        },
        "windupMs": {
          "type": "number",
          "minimum": 0
        },
        "attackDurationMs": {
          "type": "number",
          "minimum": 0
        },
        "recoveryMs": {
          "type": "number",
          "minimum": 0
        },
        "rangePadding": {
          "type": "number",
          "minimum": 0
        },
        "windupSound": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "cooldownMs"
      ],
      "additionalProperties": false
    },
    "moves": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/move"
      }
    },
    "form": {
      "type": "object",
      "properties": {
        "components": {
          "$ref": "#/$defs/components"
        },
        "moves": {
          "$ref": "#/$defs/moves"
        },
        "poses": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/pose"
              }
            }
          ]
        },
        "healthRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sequence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pose": {
                "type": "string",
                "minLength": 1
              },
              "durationMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "pose",
              "durationMs"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "required": [
        "combat",
        "body",
        "presentation",
        "lines",
        "components",
        "moves"
      ],
      "properties": {
        "combat": {
          "type": "object",
          "properties": {
            "maxHealth": {
              "$ref": "#/$defs/positiveNumber"
            },
            "speed": {
              "$ref": "#/$defs/positiveNumber"
            },
            "baseDamage": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "impactDamageMultiplier": {
              "$ref": "#/$defs/nonNegativeNumber"
            },
            "faceTarget": {
              "$ref": "#/$defs/faceTarget"
            }
          },
          "additionalProperties": false,
          "required": [
            "maxHealth",
            "speed",
            "baseDamage",
            "impactDamageMultiplier",
            "faceTarget"
          ]
        },
        "body": {
          "type": "object",
          "properties": {
            "radius": {
              "$ref": "#/$defs/positiveNumber"
            },
            "hitbox": {
              "$ref": "#/$defs/hitbox"
            },
            "hitboxOffset": {
              "$ref": "#/$defs/vector"
            }
          },
          "additionalProperties": false,
          "required": [
            "radius",
            "hitbox",
            "hitboxOffset"
          ]
        },
        "presentation": {
          "type": "object",
          "properties": {
            "image": {
              "type": [
                "string",
                "null"
              ]
            },
            "imageScale": {
              "$ref": "#/$defs/positiveNumber"
            },
            "imageOffset": {
              "$ref": "#/$defs/vector"
            },
            "imageCrop": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/crop"
                }
              ]
            },
            "healthBarOffset": {
              "$ref": "#/$defs/vector"
            },
            "weaponScale": {
              "$ref": "#/$defs/positiveNumber"
            },
            "weaponOffset": {
              "$ref": "#/$defs/vector"
            },
            "weaponPivot": {
              "$ref": "#/$defs/vector"
            },
            "weaponIdle": {
              "type": [
                "string",
                "null"
              ]
            },
            "weaponAttack": {
              "type": [
                "string",
                "null"
              ]
            },
            "defaultFacing": {
              "enum": [
                "left",
                "right"
              ]
            },
            "poses": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/$defs/pose"
                  }
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "image",
            "imageScale",
            "imageOffset",
            "imageCrop",
            "healthBarOffset",
            "weaponScale",
            "weaponOffset",
            "weaponPivot",
            "defaultFacing",
            "poses"
          ]
        },
        "lines": {
          "$ref": "#/$defs/lines"
        },
        "components": {
          "$ref": "#/$defs/components"
        },
        "moves": {
          "$ref": "#/$defs/moves"
        }
      },
      "additionalProperties": false
    }
  }
}
