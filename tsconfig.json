{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true, "checkJs": false, "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src", "tools/**/*.ts", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
